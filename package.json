{
  "name": "order-management",
  "private": true,
  "description": "Multi-tenant order management backend — a step-by-step learning project",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @oms/api dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "db:migrate": "pnpm --filter @oms/api db:migrate",
    "db:seed": "pnpm --filter @oms/api db:seed",
    "db:reset": "pnpm --filter @oms/api db:reset",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
