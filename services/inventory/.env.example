# Copy to .env (services/inventory/.env). Every key is validated at boot (src/config/env.schema.ts).
NODE_ENV=development
# debug | info | warn | error. Pretty lines for a terminal; a deploy logs JSON (LOG_PRETTY=false).
LOG_LEVEL=info
LOG_PRETTY=true
# Traces go to the OpenTelemetry Collector of `pnpm infra:up` (Grafana: http://localhost:3001).
# Empty: nothing is sent.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The service: the application role. It reads and writes rows and cannot run DDL.
# Its own Postgres (postgres-inventory, 5435): nothing is shared with the other services.
DATABASE_URL=postgresql://inventory_app:inventory_app@localhost:5435/inventory?schema=public
DATABASE_POOL_MAX=10
# Prisma CLI only: the owner of the tables. Not in env.schema.ts, and a deployed service
# never gets it.
DATABASE_ADMIN_URL=postgresql://inventory:inventory@localhost:5435/inventory?schema=public

# the broker between the services (management UI: http://localhost:15672, guest / guest)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# commands one process works on at a time
RABBITMQ_PREFETCH=10
# a message whose consumer died holding it this many times is parked without being handled
RABBITMQ_REDELIVERY_LIMIT=10
# a command whose handling failed is delivered again after this delay…
RABBITMQ_RETRY_DELAY_MS=2000
# …at most this many times in all; then it is parked in inventory.commands.dlq, unanswered
INVENTORY_COMMANDS_MAX_ATTEMPTS=4
# the delay of inventory.commands alone (unset: RABBITMQ_RETRY_DELAY_MS)
# INVENTORY_COMMANDS_RETRY_DELAY_MS=2000

# the outbox: an event waits in a table until the relay of this process publishes it
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# how long the relay waits for the broker to confirm one message
OUTBOX_PUBLISH_TIMEOUT_MS=5000
# days a published message is kept, and how often this process deletes the older ones
OUTBOX_RETENTION_DAYS=7
OUTBOX_CLEANUP_INTERVAL_MS=3600000
# the inbox: days the record of a handled command is kept, and how often the older ones are deleted
INBOX_RETENTION_DAYS=7
INBOX_CLEANUP_INTERVAL_MS=3600000
