// The database of inventory-service: its own server, nothing shared with the other services.
// - `product_id`, `order_id` and `workspace_id` are ids of the api: plain columns, no foreign key.
// - The tenant is a column only: no user reads this database, the only way in is a command
//   (docs/adr/0016-inventory-service.md).
// CHECK constraints live in the migration SQL: Prisma cannot express them.
// Ids are UUIDv7 generated by the application (shared/domain/id.ts), never by the database.

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// The stock of one product. Free = on_hand - reserved, never below zero (a CHECK).
/// The hot row of the service: every reservation of the product locks it (SELECT … FOR UPDATE).
model StockItem {
  workspaceId String   @map("workspace_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  /// physically there, held or not
  onHand      Int      @map("on_hand")
  /// held by reservations that are RESERVED
  reserved    Int      @default(0)
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  @@id([workspaceId, productId])
  @@map("stock_items")
}

enum ReservationStatus {
  RESERVED
  REJECTED
  RELEASED
}

/// What one attempt of an order holds: every line or none. Written once per (order, attempt)
/// and changed once at most, RESERVED → RELEASED.
model Reservation {
  id          String            @id @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  orderId     String            @map("order_id") @db.Uuid
  /// which placing of the order: placed again, it asks for a new reservation
  attempt     Int
  status      ReservationStatus
  /// optimistic lock: two releases of one reservation give the stock back once
  version     Int               @default(0)
  createdAt   DateTime          @map("created_at") @db.Timestamptz(3)
  /// RELEASED only
  releasedAt  DateTime?         @map("released_at") @db.Timestamptz(3)

  lines ReservationLine[]

  /// a command is delivered at least once, and a release may come before its reserve: the
  /// second writer finds this row
  @@unique([orderId, attempt])
  @@map("reservations")
}

/// One product of a reservation. Empty for a reservation released before it was asked for.
model ReservationLine {
  reservationId String @map("reservation_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid
  quantity      Int
  /// REJECTED only, and only on a line that fell short: what was free then
  available     Int?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@id([reservationId, productId])
  @@map("reservation_lines")
}

/// A message for the broker, written in the transaction of the change it tells about and
/// published by the relay of this process (docs/adr/0014-transactional-outbox.md).
/// No updated_at: the only update is `published_at`, once.
model OutboxMessage {
  /// = `messageId` of the envelope: a message published twice is the same message
  id          String    @id @db.Uuid
  exchange    String
  routingKey  String    @map("routing_key")
  /// the whole envelope, as `Contract.create()` built it
  payload     Json
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  /// the trace the row was written in, for the relay to publish it in (docs/adr/0025)
  traceContext Json?    @map("trace_context")

  // the relay: `published_at IS NULL ORDER BY id`; the cleanup: `published_at < …`
  @@index([publishedAt, id])
  @@map("outbox")
}

/// A command this service has handled, written in the transaction of what it caused,
/// the answer included (docs/adr/0015-idempotent-consumers.md): the same message is
/// handled once per consumer.
model InboxMessage {
  /// the queue the message was read from
  consumer    String
  /// = `messageId` of the envelope
  messageId   String   @map("message_id") @db.Uuid
  processedAt DateTime @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, messageId])
  // the cleanup: `processed_at < …`
  @@index([processedAt])
  @@map("inbox")
}
