# Environment of the test projects (vitest.config.mts → env). Test-only values, committed.
# The dev .env is never read in tests: ConfigModule ignores env files when NODE_ENV=test.
NODE_ENV=test

# Placeholders: test/setup/db.ts points them at the containers of the current run.
DATABASE_URL=postgresql://unset:unset@localhost:1/unset
RABBITMQ_URL=amqp://unset:unset@localhost:1
SMTP_HOST=localhost
SMTP_PORT=1
MAIL_FROM=Orders <orders@oms.test>
# one event at a time: a test that needs two at once starts a second application
RABBITMQ_PREFETCH=1
# a redelivery is a fraction of a second away, and the third delivery is the last
RABBITMQ_RETRY_DELAY_MS=200
RABBITMQ_REDELIVERY_LIMIT=3
NOTIFICATIONS_ORDER_EVENTS_MAX_ATTEMPTS=3

# the dispatcher looks for work often, so a test does not wait a second for each mail
NOTIFICATIONS_DISPATCH_INTERVAL_MS=50
# a mail server that is away is given up on quickly, and the third try is the last
SMTP_TIMEOUT_MS=1000
NOTIFICATIONS_MAX_SEND_ATTEMPTS=3
NOTIFICATIONS_SEND_RETRY_DELAY_MS=100

# no metrics endpoint: a test reads the registry of the application
METRICS_PORT=0
