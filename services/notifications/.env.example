# Copy to .env (services/notifications/.env). Every key is validated at boot (src/config/env.schema.ts).
# 127.0.0.1, not localhost: where localhost resolves to ::1 first and the port forwarding of
# Docker answers over IPv4 only, a connection hangs or is reset.
NODE_ENV=development
# debug | info | warn | error. Pretty lines for a terminal; a deploy logs JSON (LOG_PRETTY=false).
LOG_LEVEL=info
LOG_PRETTY=true
# Traces go to the OpenTelemetry Collector of `pnpm infra:up` (Grafana: http://localhost:3001).
# Empty: nothing is sent.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# otlp: the log lines go there too (Loki). none in a container: an agent reads its stdout.
OTEL_LOGS_EXPORTER=otlp
# GET /metrics for Prometheus. Unset: 9468. 0: not served.
# METRICS_PORT=9468

# The service: the application role. It reads and writes rows and cannot run DDL.
# Its own Postgres (postgres-notifications, 5436): nothing is shared with the other services.
DATABASE_URL=postgresql://notifications_app:notifications_app@127.0.0.1:5436/notifications?schema=public
DATABASE_POOL_MAX=10
# Prisma CLI only: the owner of the tables. Not in env.schema.ts, and a deployed service
# never gets it.
DATABASE_ADMIN_URL=postgresql://notifications:notifications@127.0.0.1:5436/notifications?schema=public

# the broker between the services (management UI: http://localhost:15672, guest / guest)
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
# events one process works on at a time
RABBITMQ_PREFETCH=10
# a message whose consumer died holding it this many times is parked without being handled
RABBITMQ_REDELIVERY_LIMIT=10
# an event whose handling failed is delivered again after this delay…
RABBITMQ_RETRY_DELAY_MS=2000
# …at most this many times in all; then it is parked in notifications.order-events.dlq
NOTIFICATIONS_ORDER_EVENTS_MAX_ATTEMPTS=4
# the delay of notifications.order-events alone (unset: RABBITMQ_RETRY_DELAY_MS)
# NOTIFICATIONS_ORDER_EVENTS_RETRY_DELAY_MS=2000

# the mail server: Mailpit of docker-compose.yml (what it caught: http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# both or neither; Mailpit asks for no login
# SMTP_USER=
# SMTP_PASSWORD=
# how long one mail may take before the try counts as failed
SMTP_TIMEOUT_MS=5000
MAIL_FROM=Orders <orders@oms.local>

# the dispatcher: a notification waits in a table until this process sends it
NOTIFICATIONS_DISPATCH_ENABLED=true
NOTIFICATIONS_DISPATCH_INTERVAL_MS=1000
# tries of one mail; the wait after the first failed one, doubled with every next
NOTIFICATIONS_MAX_SEND_ATTEMPTS=5
NOTIFICATIONS_SEND_RETRY_DELAY_MS=30000
# days a notification that was sent or given up is kept, and how often the older ones are deleted
NOTIFICATIONS_RETENTION_DAYS=30
NOTIFICATIONS_CLEANUP_INTERVAL_MS=3600000
# the inbox: days the record of a handled event is kept, and how often the older ones are deleted
INBOX_RETENTION_DAYS=7
INBOX_CLEANUP_INTERVAL_MS=3600000
