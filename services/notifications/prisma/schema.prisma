// The database of notifications-service: its own server, nothing shared with the other services.
// - `order_id`, `recipient_user_id` and `workspace_id` are ids of the api: plain columns, no foreign key.
// - The tenant is a column only: no user reads this database, the only way in is an event
//   (docs/adr/0019-notifications-service.md).
// CHECK constraints live in the migration SQL: Prisma cannot express them.
// Ids are UUIDv7 generated by the application (shared/domain/id.ts), never by the database.

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// A mail the service owes a user: written in the transaction that records the event, sent
/// afterwards by the dispatcher of this process. The row is the intent and the record.
model Notification {
  id              String             @id @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  orderId         String             @map("order_id") @db.Uuid
  /// what it tells: `order-placed`, `order-paid`, …
  kind            String
  /// the payment attempt it is about; 0 for what happens to an order once
  attempt         Int
  recipientUserId String             @map("recipient_user_id") @db.Uuid
  recipientEmail  String             @map("recipient_email")
  /// rendered when the event arrived: what is sent is what was written
  subject         String
  body            String
  status          NotificationStatus
  /// tries so far, the successful one included
  sendAttempts    Int                @default(0) @map("send_attempts")
  /// PENDING only: not before this moment
  nextAttemptAt   DateTime?          @map("next_attempt_at") @db.Timestamptz(3)
  /// why the last try failed
  lastError       String?            @map("last_error")
  /// when the fact happened, as the event said
  occurredAt      DateTime           @map("occurred_at") @db.Timestamptz(3)
  /// the chain of the event that asked for it: the mail is sent later, by a timer, and is
  /// logged under this id. NULL: written before the column was there
  correlationId   String?            @map("correlation_id") @db.Uuid
  createdAt       DateTime           @map("created_at") @db.Timestamptz(3)
  /// SENT or FAILED: when it was sent, or given up; the cleanup counts from here
  settledAt       DateTime?          @map("settled_at") @db.Timestamptz(3)

  /// one mail per fact: another message about the same fact finds this row
  @@unique([orderId, kind, attempt])
  // the dispatcher: `status = 'PENDING' AND next_attempt_at <= now ORDER BY next_attempt_at`
  @@index([status, nextAttemptAt])
  // the cleanup: `settled_at < …`
  @@index([settledAt])
  @@map("notifications")
}

/// An event this service has handled, written in the transaction of the notification it
/// caused (docs/adr/0015-idempotent-consumers.md): the same message is handled once.
model InboxMessage {
  /// the queue the message was read from
  consumer    String
  /// = `messageId` of the envelope
  messageId   String   @map("message_id") @db.Uuid
  processedAt DateTime @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, messageId])
  // the cleanup: `processed_at < …`
  @@index([processedAt])
  @@map("inbox")
}
