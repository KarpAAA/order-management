{
  "name": "@oms/notifications",
  "version": "0.0.0",
  "private": true,
  "description": "Notifications service: writes to the user of an order when an event about it arrives",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --env-file .env --shell --exec \"node --require ./dist/instrumentation.js\"",
    "start:worker": "node --require ./dist/instrumentation.js dist/entrypoints/main.worker.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "9.1.0",
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@oms/contracts": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-amqplib": "0.71.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/instrumentation-pino": "0.70.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "nestjs-cls": "7.0.1",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@swc/core": "1.16.20",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/rabbitmq": "12.2.1",
    "@types/amqplib": "0.10.8",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "5.4.0",
    "eslint-plugin-import": "2.32.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
