# Copy to .env (services/payments/.env). Every key is validated at boot (src/config/env.schema.ts).
NODE_ENV=development

# The service: the application role. It reads and writes rows and cannot run DDL.
# Its own Postgres (postgres-payments, 5434): nothing is shared with the api's database.
DATABASE_URL=postgresql://payments_app:payments_app@localhost:5434/payments?schema=public
DATABASE_POOL_MAX=10
# Prisma CLI only: the owner of the tables. Not in env.schema.ts, and a deployed service
# never gets it.
DATABASE_ADMIN_URL=postgresql://payments:payments@localhost:5434/payments?schema=public

# the broker between the services (management UI: http://localhost:15672, guest / guest)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# commands one process works on at a time
RABBITMQ_PREFETCH=10
# a message whose consumer died holding it this many times is parked without being handled
RABBITMQ_REDELIVERY_LIMIT=10
# a command whose handling failed is delivered again after this delay…
RABBITMQ_RETRY_DELAY_MS=30000
# …at most this many times in all; then it is answered as failed or parked in payments.commands.dlq
PAYMENTS_COMMANDS_MAX_ATTEMPTS=4
# the delay of payments.commands alone (unset: RABBITMQ_RETRY_DELAY_MS)
# PAYMENTS_COMMANDS_RETRY_DELAY_MS=30000

# the outbox: an event waits in a table until the relay of this process publishes it
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# how long the relay waits for the broker to confirm one message
OUTBOX_PUBLISH_TIMEOUT_MS=5000
# days a published message is kept, and how often this process deletes the older ones
OUTBOX_RETENTION_DAYS=7
OUTBOX_CLEANUP_INTERVAL_MS=3600000
# the inbox: days the record of a handled command is kept, and how often the older ones are deleted
INBOX_RETENTION_DAYS=7
INBOX_CLEANUP_INTERVAL_MS=3600000

# http = call devtools/fake-psp over HTTP, fake = in-process deterministic gateway
PAYMENT_GATEWAY=http
PSP_BASE_URL=http://localhost:4010
PSP_TIMEOUT_MS=3000
