# Environment of the test projects (vitest.config.mts → env). Test-only values, committed.
# The dev .env is never read in tests: ConfigModule ignores env files when NODE_ENV=test.
NODE_ENV=test

# Placeholders: test/setup/db.ts points both at the containers of the current run.
DATABASE_URL=postgresql://unset:unset@localhost:1/unset
RABBITMQ_URL=amqp://unset:unset@localhost:1
# one command at a time: a test that needs two at once starts a second application
RABBITMQ_PREFETCH=1
# a redelivery is a fraction of a second away, and the third delivery is the last
RABBITMQ_RETRY_DELAY_MS=200
RABBITMQ_REDELIVERY_LIMIT=3
PAYMENTS_COMMANDS_MAX_ATTEMPTS=3

# the relay looks for new messages often, so a test does not wait a second for each
OUTBOX_POLL_INTERVAL_MS=50
OUTBOX_PUBLISH_TIMEOUT_MS=1000

# The e2e suite replaces the gateway with test/doubles/test-psp.ts; the HTTP adapter is tested
# against MSW.
PAYMENT_GATEWAY=fake
PSP_BASE_URL=http://localhost:1

# no metrics endpoint: a test reads the registry of the application
METRICS_PORT=0
