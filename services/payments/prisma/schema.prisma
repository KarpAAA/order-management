// The database of payments-service: its own server, nothing shared with the api.
// - `order_id` and `workspace_id` are ids of another service: plain columns, no foreign key.
// - The tenant is a column only: no user reads this database, the only way in is a command
//   from the api (docs/adr/0012-payments-service-over-rabbitmq.md).
// CHECK constraints live in the migration SQL: Prisma cannot express them.
// Ids are UUIDv7 generated by the application (shared/domain/id.ts), never by the database.

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One payment attempt of an order. Created PENDING before the provider is called, settled once.
model Payment {
  id             String        @id @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  attempt        Int
  amountMinor    BigInt        @map("amount_minor")
  currency       String        @db.Char(3)
  /// sent to the provider: the same key never charges twice
  idempotencyKey String        @map("idempotency_key")
  status         PaymentStatus @default(PENDING)
  /// the provider's id of the charge; null while PENDING and when the provider never answered
  pspChargeId    String?       @map("psp_charge_id")
  /// FAILED only: the provider's decline code, `psp_unavailable` or `psp_rejected`
  failureCode    String?       @map("failure_code")
  /// of the command; carried into the event that answers it
  correlationId  String        @map("correlation_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt      DateTime?     @map("settled_at") @db.Timestamptz(3)

  /// the command is delivered at least once: the second delivery finds this row
  @@unique([orderId, attempt])
  @@map("payments")
}

/// A message for the broker, written in the transaction of the change it tells about and
/// published by the relay of this process (docs/adr/0014-transactional-outbox.md).
/// No updated_at: the only update is `published_at`, once.
model OutboxMessage {
  /// = `messageId` of the envelope: a message published twice is the same message
  id          String    @id @db.Uuid
  exchange    String
  routingKey  String    @map("routing_key")
  /// the whole envelope, as `Contract.create()` built it
  payload     Json
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  // the relay: `published_at IS NULL ORDER BY id`; the cleanup: `published_at < …`
  @@index([publishedAt, id])
  @@map("outbox")
}

/// A command this service has handled, written in the transaction that settles the payment
/// and writes the answer (docs/adr/0015-idempotent-consumers.md): the same message is
/// handled once per consumer.
model InboxMessage {
  /// the queue the message was read from
  consumer    String
  /// = `messageId` of the envelope
  messageId   String   @map("message_id") @db.Uuid
  processedAt DateTime @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, messageId])
  // the cleanup: `processed_at < …`
  @@index([processedAt])
  @@map("inbox")
}
