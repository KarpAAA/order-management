// The database of payments-service: its own server, nothing shared with the api.
// - `order_id` and `workspace_id` are ids of another service: plain columns, no foreign key.
// - The tenant is a column only: no user reads this database, the only way in is a command
//   from the api (docs/adr/0012-payments-service-over-rabbitmq.md).
// CHECK constraints live in the migration SQL: Prisma cannot express them.
// Ids are UUIDv7 generated by the application (shared/domain/id.ts), never by the database.

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One payment attempt of an order. Created PENDING before the provider is called, settled once.
model Payment {
  id             String        @id @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  attempt        Int
  amountMinor    BigInt        @map("amount_minor")
  currency       String        @db.Char(3)
  /// sent to the provider: the same key never charges twice
  idempotencyKey String        @map("idempotency_key")
  status         PaymentStatus @default(PENDING)
  /// the provider's id of the charge; null while PENDING and when the provider never answered
  pspChargeId    String?       @map("psp_charge_id")
  /// FAILED only: the provider's decline code, `psp_unavailable` or `psp_rejected`
  failureCode    String?       @map("failure_code")
  /// of the command; carried into the event that answers it
  correlationId  String        @map("correlation_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt      DateTime?     @map("settled_at") @db.Timestamptz(3)

  /// the command is delivered at least once: the second delivery finds this row
  @@unique([orderId, attempt])
  @@map("payments")
}
