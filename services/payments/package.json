{
  "name": "@oms/payments",
  "version": "0.0.0",
  "private": true,
  "description": "Payments service: charges a payment attempt at the PSP on a command, answers with an event",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start:worker": "node dist/entrypoints/main.worker.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:explain:resilience": "tsx prisma/explain/resilience.ts"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "9.1.0",
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@oms/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cockatiel": "4.0.0",
    "nestjs-cls": "7.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/rabbitmq": "12.1.0",
    "@types/amqplib": "0.10.8",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "5.4.0",
    "eslint-plugin-import": "2.32.0",
    "msw": "2.15.0",
    "prisma": "7.10.0",
    "testcontainers": "12.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
