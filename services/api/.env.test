# Environment of the e2e project (vitest.config.mts → env). Test-only values, committed.
# The dev .env is never read in tests: ConfigModule ignores env files when NODE_ENV=test.
NODE_ENV=test
CORS_ORIGINS=http://localhost:3000

# Placeholders: test/setup/db.ts points all three at the containers of the current run.
DATABASE_URL=postgresql://unset:unset@localhost:1/unset
REDIS_URL=redis://localhost:1
RABBITMQ_URL=amqp://unset:unset@localhost:1
# placeholder: test/setup/db.ts gives each test file its own prefix
QUEUE_PREFIX=unset
CACHE_PREFIX=unset
# query events on: countQueries in test/helpers/api-app.ts counts them (N+1 guard)
DATABASE_LOG_QUERIES=true

JWT_SECRET=test-only-secret-0123456789abcdef-0123456789
JWT_ACCESS_TTL_SECONDS=900

# Vendors are fakes in tests; the HTTP adapter is tested against MSW (1.10).
PAYMENT_GATEWAY=fake
PSP_BASE_URL=http://localhost:1

ORDERS_WORKER_CONCURRENCY=1
CHARGE_ATTEMPTS=3
CHARGE_BACKOFF_MS=10

ORDER_EVENTS_PARTITIONS_AHEAD=3
ORDER_EVENTS_RETENTION_MONTHS=0
ORDER_EVENTS_PARTITIONS_ENABLED=true

SWAGGER_ENABLED=false
BULL_BOARD_ENABLED=false
