# Copy to .env (services/api/.env). Every key is validated at boot (src/config/env.schema.ts).
NODE_ENV=development
API_PORT=3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://oms:oms@localhost:5432/oms?schema=public
REDIS_URL=redis://localhost:6379

# Dev-only secret (>= 32 chars). Never reuse outside local development.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# 1 hour for local convenience; there are no refresh tokens in this project.
JWT_ACCESS_TTL_SECONDS=3600

# http = call devtools/fake-psp over HTTP, fake = in-process deterministic gateway
PAYMENT_GATEWAY=http
PSP_BASE_URL=http://localhost:4010
PSP_TIMEOUT_MS=3000

ORDERS_WORKER_CONCURRENCY=10
CHARGE_ATTEMPTS=5
CHARGE_BACKOFF_MS=1000

SWAGGER_ENABLED=true
BULL_BOARD_ENABLED=true
