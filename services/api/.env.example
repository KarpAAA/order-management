# Copy to .env (services/api/.env). Every key is validated at boot (src/config/env.schema.ts).
NODE_ENV=development
API_PORT=3000
CORS_ORIGINS=http://localhost:3000

# api + worker: the application role, through PgBouncer in transaction mode (6432), as in the
# containers. It owns no table and sees only the rows of the current workspace (Row-Level
# Security).
DATABASE_URL=postgresql://oms_app:oms_app@localhost:6432/oms?schema=public
# connections one process keeps open; behind PgBouncer they are client connections
DATABASE_POOL_MAX=10
# Prisma CLI, seed and datagen only: the owner of the tables. Not in env.schema.ts, and a
# deployed api or worker never gets it. Always Postgres itself (5432), never PgBouncer.
DATABASE_ADMIN_URL=postgresql://oms:oms@localhost:5432/oms?schema=public
# measuring scripts only (pnpm db:explain:pgbouncer, rls-frame.ts): the application role past
# the pooler, the same role through it, and PgBouncer's console
DATABASE_DIRECT_URL=postgresql://oms_app:oms_app@localhost:5432/oms
PGBOUNCER_URL=postgresql://oms_app:oms_app@localhost:6432/oms
PGBOUNCER_STATS_URL=postgresql://stats:stats@localhost:6432/pgbouncer
# true = every SQL statement at debug level (Prisma `query` event)
DATABASE_LOG_QUERIES=false
REDIS_URL=redis://localhost:6379
# namespace of the BullMQ keys in Redis (api and worker must agree)
QUEUE_PREFIX=bull

# Dev-only secret (>= 32 chars). Never reuse outside local development.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# 1 hour for local convenience; there are no refresh tokens in this project.
JWT_ACCESS_TTL_SECONDS=900

# http = call devtools/fake-psp over HTTP, fake = in-process deterministic gateway
PAYMENT_GATEWAY=http
PSP_BASE_URL=http://localhost:4010
PSP_TIMEOUT_MS=3000

ORDERS_WORKER_CONCURRENCY=10
CHARGE_ATTEMPTS=5
CHARGE_BACKOFF_MS=1000

# order_events is partitioned by month: the worker keeps this many months ready ahead,
# and drops months older than the retention (0 = keep everything)
ORDER_EVENTS_PARTITIONS_AHEAD=3
ORDER_EVENTS_RETENTION_MONTHS=0
ORDER_EVENTS_PARTITIONS_ENABLED=true

SWAGGER_ENABLED=true
BULL_BOARD_ENABLED=true
