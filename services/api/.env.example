# Copy to .env (services/api/.env). Every key is validated at boot (src/config/env.schema.ts).
NODE_ENV=development
API_PORT=3000
CORS_ORIGINS=http://localhost:3000

# api + worker: the application role, through PgBouncer in transaction mode (6432), as in the
# containers. It owns no table and sees only the rows of the current workspace (Row-Level
# Security).
DATABASE_URL=postgresql://oms_app:oms_app@localhost:6432/oms?schema=public
# connections one process keeps open; behind PgBouncer they are client connections
DATABASE_POOL_MAX=10
# The read replica, through PgBouncer's pool for it: GET requests read it (ADR 0009). Empty or
# absent = no replica, every read goes to the primary.
DATABASE_REPLICA_URL=postgresql://oms_app:oms_app@localhost:6432/oms_replica?schema=public
# how long after a write the writer's reads are checked against the replica's position
READ_YOUR_WRITES_TTL_SECONDS=60
# Prisma CLI, seed and datagen only: the owner of the tables. Not in env.schema.ts, and a
# deployed api or worker never gets it. Always Postgres itself (5432), never PgBouncer.
DATABASE_ADMIN_URL=postgresql://oms:oms@localhost:5432/oms?schema=public
# measuring scripts only (pnpm db:explain:pgbouncer, rls-frame.ts): the application role past
# the pooler, the same role through it, and PgBouncer's console
DATABASE_DIRECT_URL=postgresql://oms_app:oms_app@localhost:5432/oms
PGBOUNCER_URL=postgresql://oms_app:oms_app@localhost:6432/oms
PGBOUNCER_STATS_URL=postgresql://stats:stats@localhost:6432/pgbouncer
# pnpm db:explain:replica only: the replica itself (5433), as the application role and as the owner
REPLICA_DIRECT_URL=postgresql://oms_app:oms_app@localhost:5433/oms
REPLICA_ADMIN_URL=postgresql://oms:oms@localhost:5433/oms
# true = every SQL statement at debug level (Prisma `query` event)
DATABASE_LOG_QUERIES=false
REDIS_URL=redis://localhost:6379
# namespace of the BullMQ keys in Redis (api and worker must agree)
QUEUE_PREFIX=bull
# namespace of the cache keys in Redis
CACHE_PREFIX=cache
# the broker between the services (management UI: http://localhost:15672, guest / guest)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# messages one process works on at a time
RABBITMQ_PREFETCH=10
# a message whose consumer died holding it this many times is parked without being handled
RABBITMQ_REDELIVERY_LIMIT=10
# a message whose handling failed is delivered again after this delay…
RABBITMQ_RETRY_DELAY_MS=30000
# …at most this many times in all; then it is parked in api.payment-events.dlq
PAYMENT_EVENTS_MAX_ATTEMPTS=10
# the delay of api.payment-events alone (unset: RABBITMQ_RETRY_DELAY_MS)
# PAYMENT_EVENTS_RETRY_DELAY_MS=30000
# the outbox: a message for the broker waits in a table until the relay of the worker publishes it
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# how long the relay waits for the broker to confirm one message
OUTBOX_PUBLISH_TIMEOUT_MS=5000
# days a published message is kept
OUTBOX_RETENTION_DAYS=7
# the inbox: days the record of a handled broker message is kept
INBOX_RETENTION_DAYS=7
# seconds a cached product or list page lives (a change through the API invalidates at once); 0 = off
CATALOG_CACHE_TTL_SECONDS=300

# Dev-only secret (>= 32 chars). Never reuse outside local development.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# 1 hour for local convenience; there are no refresh tokens in this project.
JWT_ACCESS_TTL_SECONDS=900

# The payment provider is configured in services/payments/.env: the api only sends the command.

ORDERS_WORKER_CONCURRENCY=10

# order_events is partitioned by month: the worker keeps this many months ready ahead,
# and drops months older than the retention (0 = keep everything)
ORDER_EVENTS_PARTITIONS_AHEAD=3
ORDER_EVENTS_RETENTION_MONTHS=0
ORDER_EVENTS_PARTITIONS_ENABLED=true

SWAGGER_ENABLED=true
BULL_BOARD_ENABLED=true
