// Tenancy model (docs/adr/0002-composite-tenant-keys.md):
// - global tables: users, workspaces (future Citus reference tables)
// - tenant tables: PK (workspace_id, id); FKs between tenant tables include workspace_id
//   (order_sagas: PK (workspace_id, order_id, attempt), a saga has no id of its own)
// - order_events: PK (workspace_id, id, created_at); PARTITION BY RANGE (created_at), monthly.
//   Prisma cannot express that: the DDL is in migration 20261001120000_partition_order_events,
//   later partitions come from the worker job (docs/adr/0005-order-events-partitioning.md)
// CHECK constraints live in the migration SQL: Prisma cannot express them.
// Ids are UUIDv7 generated by the application (shared/domain/id.ts), never by the database.

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── identity ────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String   @id @db.Uuid
  /// @pii stored lower-cased, so the unique index is case-insensitive
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  createdOrders Order[]

  @@map("users")
}

model Workspace {
  id         String   @id @db.Uuid
  name       String
  slug       String   @unique
  currency   String   @db.Char(3)
  taxRateBps Int      @map("tax_rate_bps")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  products    Product[]
  orders      Order[]
  orderItems  OrderItem[]
  orderEvents OrderEvent[]
  orderSagas  OrderSaga[]

  @@map("workspaces")
}

model Membership {
  workspaceId String        @map("workspace_id") @db.Uuid
  id          String        @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([workspaceId, id])
  @@unique([workspaceId, userId])
  // keyset lists: members of a workspace, workspaces of a user (newest first, id tiebreak)
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("memberships")
}

// ── catalog ─────────────────────────────────────────────────────────────────

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Product {
  workspaceId String        @map("workspace_id") @db.Uuid
  id          String        @db.Uuid
  sku         String
  name        String
  description String?
  priceMinor  BigInt        @map("price_minor")
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@id([workspaceId, id])
  @@unique([workspaceId, sku])
  // keyset list: ORDER BY created_at DESC, id DESC, optionally filtered by status
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("products")
}

// ── orders ──────────────────────────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  FULFILLED
  CANCELLED
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

enum OrderEventType {
  ORDER_CREATED
  ORDER_PLACED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  ORDER_FULFILLED
  ORDER_CANCELLED
  STOCK_RESERVED
  STOCK_RESERVATION_FAILED
  STOCK_RELEASED
  PAYMENT_TIMED_OUT
}

enum OrderSagaStep {
  RESERVING
  CHARGING
  CANCELLING_PAYMENT
  RELEASING
  COMPLETED
  ABORTED
}

model Order {
  workspaceId        String       @map("workspace_id") @db.Uuid
  id                 String       @db.Uuid
  status             OrderStatus
  currency           String       @db.Char(3)
  discountType       DiscountType @map("discount_type")
  discountValueBps   Int?         @map("discount_value_bps")
  discountValueMinor BigInt?      @map("discount_value_minor")
  taxRateBps         Int          @map("tax_rate_bps")
  subtotalMinor      BigInt       @map("subtotal_minor")
  discountMinor      BigInt       @map("discount_minor")
  taxMinor           BigInt       @map("tax_minor")
  totalMinor         BigInt       @map("total_minor")
  paymentAttempt     Int          @map("payment_attempt")
  pspChargeId        String?      @map("psp_charge_id")
  failureReason      String?      @map("failure_reason")
  version            Int          @default(0)
  createdBy          String       @map("created_by") @db.Uuid
  createdAt          DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @map("updated_at") @db.Timestamptz(3)
  placedAt           DateTime?    @map("placed_at") @db.Timestamptz(3)
  paidAt             DateTime?    @map("paid_at") @db.Timestamptz(3)
  fulfilledAt        DateTime?    @map("fulfilled_at") @db.Timestamptz(3)
  cancelledAt        DateTime?    @map("cancelled_at") @db.Timestamptz(3)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  creator   User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items     OrderItem[]
  events    OrderEvent[]
  sagas     OrderSaga[]

  @@id([workspaceId, id])
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdBy])
  @@map("orders")
}

model OrderItem {
  workspaceId    String   @map("workspace_id") @db.Uuid
  id             String   @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  position       Int
  productId      String   @map("product_id") @db.Uuid
  sku            String
  name           String
  unitPriceMinor BigInt   @map("unit_price_minor")
  quantity       Int
  lineTotalMinor BigInt   @map("line_total_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)
  product   Product   @relation(fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Restrict)

  @@id([workspaceId, id])
  @@index([workspaceId, orderId])
  @@index([workspaceId, productId])
  @@map("order_items")
}

/// Append-only history. No updated_at by design: rows are never updated.
model OrderEvent {
  workspaceId String         @map("workspace_id") @db.Uuid
  id          String         @db.Uuid
  orderId     String         @map("order_id") @db.Uuid
  type        OrderEventType
  fromStatus  OrderStatus?   @map("from_status")
  toStatus    OrderStatus    @map("to_status")
  /// user id, or `system:<source>` for system actors
  actor       String
  payload     Json           @default("{}")
  createdAt   DateTime       @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@id([workspaceId, id, createdAt])
  // keyset history: oldest first with the id tiebreak (read/query-service.md §4)
  @@index([workspaceId, orderId, createdAt, id])
  @@map("order_events")
}

/// Where one placing of an order is in its process across inventory and payments
/// (docs/adr/0017-order-saga.md). One row per payment attempt: placed again, an order starts a
/// new saga, and a late answer of the old one finds the old row.
model OrderSaga {
  workspaceId String        @map("workspace_id") @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  /// = `payment_attempt` of the order when it was placed
  attempt     Int
  step        OrderSagaStep
  /// until when the step waits for its answer; null once the saga has ended
  deadlineAt  DateTime?     @map("deadline_at") @db.Timestamptz(3)
  version     Int           @default(0)
  createdAt   DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@id([workspaceId, orderId, attempt])
  @@map("order_sagas")
}

// ── outbox ──────────────────────────────────────────────────────────────────

/// A message for the broker, written in the transaction of the change it tells about and
/// published by the relay of the worker (docs/adr/0014-transactional-outbox.md).
/// Not a tenant table: the relay reads every tenant's rows, and the tenant travels inside
/// `payload` (the envelope). No updated_at: the only update is `published_at`, once.
model OutboxMessage {
  /// = `messageId` of the envelope: a message published twice is the same message
  id          String    @id @db.Uuid
  exchange    String
  routingKey  String    @map("routing_key")
  /// the whole envelope, as `Contract.create()` built it
  payload     Json
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  // the relay: `published_at IS NULL ORDER BY id`; the cleanup: `published_at < …`
  @@index([publishedAt, id])
  @@map("outbox")
}

// ── inbox ───────────────────────────────────────────────────────────────────

/// A broker message a consumer of this service has handled, written in the transaction of
/// what the message caused (docs/adr/0015-idempotent-consumers.md): the same message is
/// handled once per consumer. Not a tenant table: a row is an id and a time, and the cleanup
/// reads every tenant's rows.
model InboxMessage {
  /// the queue the message was read from: two consumers of one event each handle it once
  consumer    String
  /// = `messageId` of the envelope
  messageId   String   @map("message_id") @db.Uuid
  processedAt DateTime @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, messageId])
  // the cleanup: `processed_at < …`
  @@index([processedAt])
  @@map("inbox")
}
