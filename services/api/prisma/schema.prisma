// Tenancy model (docs/adr/0002-composite-tenant-keys.md):
// - global tables: users, workspaces (future Citus reference tables)
// - tenant tables: PK (workspace_id, id); FKs between tenant tables include workspace_id
// - order_events: PK (workspace_id, id, created_at); PARTITION BY RANGE (created_at), monthly.
//   Prisma cannot express that: the DDL is in migration 20261001120000_partition_order_events,
//   later partitions come from the worker job (docs/adr/0005-order-events-partitioning.md)
// CHECK constraints live in the migration SQL: Prisma cannot express them.
// Ids are UUIDv7 generated by the application (shared/domain/id.ts), never by the database.

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── identity ────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String   @id @db.Uuid
  /// @pii stored lower-cased, so the unique index is case-insensitive
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  createdOrders Order[]

  @@map("users")
}

model Workspace {
  id         String   @id @db.Uuid
  name       String
  slug       String   @unique
  currency   String   @db.Char(3)
  taxRateBps Int      @map("tax_rate_bps")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  products    Product[]
  orders      Order[]
  orderItems  OrderItem[]
  orderEvents OrderEvent[]

  @@map("workspaces")
}

model Membership {
  workspaceId String        @map("workspace_id") @db.Uuid
  id          String        @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([workspaceId, id])
  @@unique([workspaceId, userId])
  // keyset lists: members of a workspace, workspaces of a user (newest first, id tiebreak)
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("memberships")
}

// ── catalog ─────────────────────────────────────────────────────────────────

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Product {
  workspaceId String        @map("workspace_id") @db.Uuid
  id          String        @db.Uuid
  sku         String
  name        String
  description String?
  priceMinor  BigInt        @map("price_minor")
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@id([workspaceId, id])
  @@unique([workspaceId, sku])
  // keyset list: ORDER BY created_at DESC, id DESC, optionally filtered by status
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("products")
}

// ── orders ──────────────────────────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  FULFILLED
  CANCELLED
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

enum OrderEventType {
  ORDER_CREATED
  ORDER_PLACED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  ORDER_FULFILLED
  ORDER_CANCELLED
}

model Order {
  workspaceId        String       @map("workspace_id") @db.Uuid
  id                 String       @db.Uuid
  status             OrderStatus
  currency           String       @db.Char(3)
  discountType       DiscountType @map("discount_type")
  discountValueBps   Int?         @map("discount_value_bps")
  discountValueMinor BigInt?      @map("discount_value_minor")
  taxRateBps         Int          @map("tax_rate_bps")
  subtotalMinor      BigInt       @map("subtotal_minor")
  discountMinor      BigInt       @map("discount_minor")
  taxMinor           BigInt       @map("tax_minor")
  totalMinor         BigInt       @map("total_minor")
  paymentAttempt     Int          @map("payment_attempt")
  pspChargeId        String?      @map("psp_charge_id")
  failureReason      String?      @map("failure_reason")
  version            Int          @default(0)
  createdBy          String       @map("created_by") @db.Uuid
  createdAt          DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @map("updated_at") @db.Timestamptz(3)
  placedAt           DateTime?    @map("placed_at") @db.Timestamptz(3)
  paidAt             DateTime?    @map("paid_at") @db.Timestamptz(3)
  fulfilledAt        DateTime?    @map("fulfilled_at") @db.Timestamptz(3)
  cancelledAt        DateTime?    @map("cancelled_at") @db.Timestamptz(3)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  creator   User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items     OrderItem[]
  events    OrderEvent[]

  @@id([workspaceId, id])
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdBy])
  @@map("orders")
}

model OrderItem {
  workspaceId    String   @map("workspace_id") @db.Uuid
  id             String   @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  position       Int
  productId      String   @map("product_id") @db.Uuid
  sku            String
  name           String
  unitPriceMinor BigInt   @map("unit_price_minor")
  quantity       Int
  lineTotalMinor BigInt   @map("line_total_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)
  product   Product   @relation(fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Restrict)

  @@id([workspaceId, id])
  @@index([workspaceId, orderId])
  @@index([workspaceId, productId])
  @@map("order_items")
}

/// Append-only history. No updated_at by design: rows are never updated.
model OrderEvent {
  workspaceId String         @map("workspace_id") @db.Uuid
  id          String         @db.Uuid
  orderId     String         @map("order_id") @db.Uuid
  type        OrderEventType
  fromStatus  OrderStatus?   @map("from_status")
  toStatus    OrderStatus    @map("to_status")
  /// user id, or `system:<source>` for system actors
  actor       String
  payload     Json           @default("{}")
  createdAt   DateTime       @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@id([workspaceId, id, createdAt])
  // keyset history: oldest first with the id tiebreak (read/query-service.md §4)
  @@index([workspaceId, orderId, createdAt, id])
  @@map("order_events")
}
