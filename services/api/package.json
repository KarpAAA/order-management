{
  "name": "@oms/api",
  "version": "0.0.0",
  "private": true,
  "description": "Order management API + worker (one image, two entrypoints)",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && pnpm run \"/^dev:(api|worker)$/\"",
    "dev:api": "nest start --watch --entryFile entrypoints/main.api",
    "dev:worker": "nest start --watch --entryFile entrypoints/main.worker --path tsconfig.worker-dev.json",
    "start:api": "node dist/entrypoints/main.api.js",
    "start:worker": "node dist/entrypoints/main.worker.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed"
  },
  "dependencies": {
    "@bull-board/api": "9.10.1",
    "@bull-board/express": "9.10.1",
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-prisma": "2.0.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/cqrs": "12.0.0",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-cls": "7.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "12.0.5",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "5.4.0",
    "eslint-plugin-import": "2.32.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
