# Commit message format: commitlint.config.mjs (quality/git-pr.md §1).
pnpm exec commitlint --edit "$1"

# The author is the human responsible for the code: no AI attribution trailers (git-pr.md §1).
if grep -qiE '^(co-authored-by|claude-session):' "$1"; then
  echo "✖ commit-msg: remove the Co-Authored-By / Claude-Session trailer (quality/git-pr.md §1)" >&2
  exit 1
fi
